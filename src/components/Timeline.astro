---
import { Image } from 'astro:assets';
import type { TimelineEntry } from '../data/cv';

interface Props {
  items: TimelineEntry[];
}

const { items } = Astro.props;
---

<ol class="timeline" data-timeline>
  <li class="track" aria-hidden="true"><span class="fill"></span></li>
  {
    items.map((e) => (
      <li class="item" data-reveal>
        <div class="period">{e.period}</div>
        <div class="node" aria-hidden={!e.logo}>
          {e.logo ? (
            <span class="logo">
              <Image src={e.logo.src} alt={e.logo.alt} width={96} height={96} />
            </span>
          ) : (
            <span class="dot" />
          )}
        </div>
        <div class="entry">
          <div class="head">
            <h3>{e.role}</h3>
            {e.location && <span class="location">{e.location}</span>}
          </div>
          <p class="where serif">{e.where}</p>
          {e.summary && <p class="summary serif">{e.summary}</p>}
          {e.bullets && (
            <ul class="serif">
              {e.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          )}
          {e.skills && (
            <div class="skills">
              {e.skills.map((skill) => (
                <span class="tag">{skill}</span>
              ))}
            </div>
          )}
        </div>
      </li>
    ))
  }
</ol>

<script>
  // Draw the timeline line as the reader scrolls; light up nodes the line has reached.
  function initTimelines() {
    const lines = [...document.querySelectorAll<HTMLElement>('[data-timeline]')];
    if (!lines.length) return;
    let ticking = false;
    const update = () => {
      ticking = false;
      const mark = window.innerHeight * 0.6;
      for (const tl of lines) {
        const r = tl.getBoundingClientRect();
        const p = Math.min(Math.max((mark - r.top) / r.height, 0), 1);
        tl.style.setProperty('--progress', p.toFixed(4));
        tl.querySelectorAll<HTMLElement>('.item').forEach((item) => {
          const node = item.querySelector('.node')!.getBoundingClientRect();
          item.classList.toggle('passed', node.top + node.height / 2 < mark);
        });
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      },
      { once: true },
    );
  }
  document.addEventListener('astro:page-load', initTimelines);
</script>

<style>
  .timeline {
    --node: 2.75rem;
    --period: 9.5rem;
    --col-gap: 1.25rem;
    --progress: 0;
    position: relative;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* The line runs through the centre of the node column. */
  .track {
    position: absolute;
    top: calc(var(--node) / 2);
    bottom: 0;
    left: calc(var(--node) / 2 - 1px);
    width: 2px;
    border-radius: 2px;
    background-color: var(--border);
  }
  .fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(var(--accent-soft), var(--accent));
    transform: scaleY(var(--progress));
    transform-origin: top;
  }
  @media (scripting: none) {
    .fill { transform: none; }
  }

  .item {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) 1fr;
    grid-template-areas:
      'node period'
      'node entry';
    column-gap: var(--col-gap);
    row-gap: 0.2rem;
  }
  @media (min-width: 768px) {
    .timeline {
      padding-left: 0;
    }
    .track {
      left: calc(var(--period) + var(--col-gap) + var(--node) / 2 - 1px);
    }
    .item {
      grid-template-columns: var(--period) var(--node) 1fr;
      grid-template-areas: 'period node entry';
    }
    .period {
      text-align: right;
      padding-top: 0.15rem;
    }
  }

  .period {
    grid-area: period;
    font-size: 0.875rem;
    color: var(--fg-mute);
    transition: color 0.4s var(--ease);
  }
  .item:global(.passed) .period { color: var(--accent-soft); }

  .node {
    grid-area: node;
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    height: var(--node);
  }
  .logo {
    display: block;
    width: var(--node);
    height: var(--node);
    padding: 0.3rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background-color: var(--logo-bg);
    box-shadow: 0 0 0 4px var(--bg), var(--shadow-sm);
    transform: scale(0.92);
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease),
      border-color 0.5s var(--ease);
  }
  .logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .dot {
    margin-top: calc(var(--node) / 2 - 0.4rem);
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 999px;
    background-color: var(--bg);
    border: 2px solid var(--border-strong);
    box-shadow: 0 0 0 4px var(--bg);
    transition: background-color 0.4s var(--ease), border-color 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .item:global(.passed) .logo {
    transform: none;
    border-color: var(--accent-soft);
    box-shadow: 0 0 0 4px var(--bg), 0 0 0 5px color-mix(in srgb, var(--accent-soft) 45%, transparent), var(--shadow-md);
  }
  .item:global(.passed) .dot {
    background-color: var(--accent);
    border-color: var(--accent);
    transform: scale(1.15);
  }
  .item:hover .logo { transform: scale(1.08); }

  .entry {
    grid-area: entry;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  @media (min-width: 768px) {
    .entry { padding-top: 0.05rem; }
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  h3 {
    font-size: 1.05rem;
    color: var(--fg);
  }
  .location {
    font-size: 0.875rem;
    color: var(--fg-mute);
    white-space: nowrap;
  }
  .where {
    font-style: italic;
    font-size: 0.95rem;
    color: var(--fg-soft);
  }
  .summary,
  ul {
    font-size: 0.925rem;
    color: var(--fg-soft);
    padding-top: 0.25rem;
    line-height: 1.6;
  }
  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding-top: 0.5rem;
  }
  ul li {
    position: relative;
    padding-left: 1.1rem;
  }
  ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    border-left: 6px solid var(--accent-soft);
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
  }
</style>
