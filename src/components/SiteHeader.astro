---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
import { url } from '../lib/url';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = url(href).replace(/\/$/, '') || '/';
  return current === target;
};
---

<header class="site-header" id="site-header" transition:name="site-header">
  <div class="container bar">
    <a href={url('/')} class="brand" transition:name="brand">
      {site.firstName} <strong>{site.lastName}</strong>
    </a>

    <nav class="desktop-nav" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={url(item.href)}
            class:list={['nav-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
            {isActive(item.href) && <span class="indicator" transition:name="nav-indicator" />}
          </a>
        ))
      }
    </nav>

    <div class="tools">
      <button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label="Toggle dark mode">
        <Icon name="sun" size={18} class="sun" />
        <Icon name="moon" size={18} class="moon" />
      </button>
      <button
        type="button"
        class="icon-btn menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <Icon name="menu" size={20} class="open" />
        <Icon name="close" size={20} class="shut" />
      </button>
    </div>
  </div>

  <div class="mobile-panel" id="mobile-nav" data-menu-panel>
    <nav class="container mobile-nav" aria-label="Main (mobile)">
      {
        nav.map((item, i) => (
          <a
            href={url(item.href)}
            class:list={['m-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
            style={`--i: ${i}`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.getElementById('site-header');
    if (!header) return;

    const update = () => header.classList.toggle('scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });

    // Theme toggle with a circular reveal where supported.
    const toggle = header.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
    toggle.addEventListener('click', (ev) => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      const apply = () => {
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      };
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!document.startViewTransition || reduce) return apply();
      const x = ev.clientX || window.innerWidth - 40;
      const y = ev.clientY || 32;
      const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      root.classList.add('theme-switching');
      const t = document.startViewTransition(apply);
      t.ready.then(() => {
        root.animate(
          { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
          { duration: 550, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', pseudoElement: '::view-transition-new(root)' },
        );
      });
      t.finished.finally(() => root.classList.remove('theme-switching'));
    });

    // Mobile menu.
    const menuBtn = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
    const setOpen = (open: boolean) => {
      header.classList.toggle('menu-open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    menuBtn.addEventListener('click', () => setOpen(!header.classList.contains('menu-open')));
    header.querySelectorAll('.m-link').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  }
  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid transparent;
    background-color: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease), background-color 0.4s var(--ease);
  }
  .site-header:global(.scrolled),
  .site-header:global(.menu-open) {
    border-bottom-color: var(--border);
    box-shadow: 0 4px 20px -12px rgb(0 0 0 / 0.25);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
  }
  .brand {
    font-size: 1.3rem;
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--accent);
    white-space: nowrap;
    margin-right: auto;
  }
  .brand strong { font-weight: 600; }
  .brand:hover { color: var(--accent-strong); }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    font-size: 0.95rem;
  }
  .nav-link {
    position: relative;
    color: var(--fg-soft);
    padding-block: 0.25rem;
  }
  .nav-link::after,
  .indicator {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    border-radius: 2px;
    background-color: var(--accent);
  }
  .nav-link::after {
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .nav-link:hover { color: var(--accent); }
  .nav-link:hover::after { transform: scaleX(1); }
  .nav-link.active {
    color: var(--accent);
    font-weight: 600;
  }
  .nav-link.active::after { display: none; }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    color: var(--fg-soft);
    cursor: pointer;
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .icon-btn:hover {
    color: var(--accent);
    background-color: var(--accent-tint);
  }
  .icon-btn :global(svg) {
    grid-area: 1 / 1;
    transition: transform 0.5s var(--ease), opacity 0.3s var(--ease);
  }
  /* sun in light mode, moon in dark mode */
  .theme-toggle :global(.moon) { opacity: 0; transform: rotate(-90deg) scale(0.5); }
  :global(:root[data-theme='dark']) .theme-toggle :global(.sun) { opacity: 0; transform: rotate(90deg) scale(0.5); }
  :global(:root[data-theme='dark']) .theme-toggle :global(.moon) { opacity: 1; transform: none; }

  .menu-toggle { display: none; }
  .menu-toggle :global(.shut) { opacity: 0; transform: rotate(-90deg); }
  .site-header:global(.menu-open) .menu-toggle :global(.open) { opacity: 0; transform: rotate(90deg); }
  .site-header:global(.menu-open) .menu-toggle :global(.shut) { opacity: 1; transform: none; }

  .mobile-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s var(--ease);
  }
  .mobile-nav {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .site-header:global(.menu-open) .mobile-panel { grid-template-rows: 1fr; }
  .m-link {
    padding: 0.7rem 0;
    font-size: 1.1rem;
    color: var(--fg-soft);
    border-top: 1px solid var(--border);
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease), color 0.2s var(--ease);
  }
  .m-link:last-child { margin-bottom: 0.75rem; }
  .m-link.active { color: var(--accent); font-weight: 600; }
  .site-header:global(.menu-open) .m-link {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 40ms + 80ms);
  }

  @media (max-width: 760px) {
    .desktop-nav { display: none; }
    .menu-toggle { display: grid; }
  }
  @media (min-width: 761px) {
    .mobile-panel { display: none; }
  }
</style>
