---
import type { ActivityEntry } from '../lib/activities';

interface Props {
  items: ActivityEntry[];
}

const events = Astro.props.items.map((n) => ({
  id: n.id,
  title: n.data.title,
  start: n.data.date,
  end: n.data.endDate,
  category: n.data.category,
}));
---

<aside class="calendar" data-activity-calendar aria-label="Activity calendar">
  <script type="application/json" data-events set:html={JSON.stringify(events)} />

  <div class="card">
    <div class="cal-head">
      <button type="button" class="nav" data-prev aria-label="Previous month">‹</button>
      <span class="cal-title" data-title aria-live="polite"></span>
      <button type="button" class="nav" data-next aria-label="Next month">›</button>
    </div>
    <div class="weekdays" aria-hidden="true">
      <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span>
    </div>
    <div class="grid" data-grid role="grid"></div>
    <ul class="month-events" data-month-events></ul>
  </div>

  <div class="card years" data-years>
    <p class="years-title">Activity</p>
  </div>
</aside>

<script>
  /*
   * Calendar side of the Activities page. It talks to the feed through DOM events:
   *   out: activities:select {ids}         – user picked a day / entry in the calendar
   *        activities:goto-month {year, month} – user picked a month in the activity strip
   *        activities:year {year}          – calendar moved to another year
   *   in:  activities:highlight {id|null, start?} – a card is hovered
   *        activities:show-year {year}     – feed switched year (tabs)
   *        activities:focused {ids}        – feed focused these cards
   *        activities:filter {categories}  – only show these categories (empty = all)
   */
  interface CalEvent {
    id: string;
    title: string;
    start: string;
    end?: string;
    category: string;
  }

  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const pad = (n: number) => String(n).padStart(2, '0');
  const ymd = (y: number, m: number, d: number) => `${y}-${pad(m)}-${pad(d)}`;
  const emit = (name: string, detail: unknown) => document.dispatchEvent(new CustomEvent(name, { detail }));

  let abort: AbortController | undefined;

  function init() {
    abort?.abort();
    const root = document.querySelector<HTMLElement>('[data-activity-calendar]');
    if (!root) return;
    abort = new AbortController();
    const { signal } = abort;

    const events: CalEvent[] = JSON.parse(root.querySelector('[data-events]')!.textContent || '[]');
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const title = root.querySelector<HTMLElement>('[data-title]')!;
    const list = root.querySelector<HTMLElement>('[data-month-events]')!;
    const years = root.querySelector<HTMLElement>('[data-years]')!;

    // Index: exact days (every day of a range) and every month an event touches.
    const byDay = new Map<string, CalEvent[]>();
    const byMonth = new Map<string, CalEvent[]>();
    const longEvents = new Set<CalEvent>();
    const addMonth = (mk: string, e: CalEvent) => {
      const inMonth = byMonth.get(mk) ?? [];
      if (!inMonth.includes(e)) byMonth.set(mk, [...inMonth, e]);
    };
    let categories = new Set<string>();
    const buildIndex = () => {
    byDay.clear();
    byMonth.clear();
    longEvents.clear();
    for (const e of events) {
      if (categories.size && !categories.has(e.category)) continue;
      const [y, m, d] = e.start.split('-').map(Number);
      if (!d) {
        addMonth(`${y}-${pad(m)}`, e);
        continue;
      }
      const startDate = new Date(Date.UTC(y, m - 1, d));
      const endDate = e.end ? new Date(e.end + 'T00:00:00Z') : startDate;
      if (endDate.getTime() - startDate.getTime() > 7 * 86400000) longEvents.add(e);
      for (let t = startDate.getTime(); t <= endDate.getTime(); t += 86400000) {
        const dt = new Date(t);
        const key = ymd(dt.getUTCFullYear(), dt.getUTCMonth() + 1, dt.getUTCDate());
        byDay.set(key, [...(byDay.get(key) ?? []), e]);
        addMonth(key.slice(0, 7), e);
      }
    }
    };
    buildIndex();

    const latest = events[0]?.start.split('-').map(Number) ?? [new Date().getFullYear(), new Date().getMonth() + 1];
    let viewYear = latest[0];
    let viewMonth = latest[1];
    let hovered: string | null = null;
    let focused: string[] = [];

    /** Latest month of a year that has activity (falls back to December). */
    const latestMonthOf = (year: number) => {
      for (let m = 12; m >= 1; m--) if (byMonth.has(`${year}-${pad(m)}`)) return m;
      return 12;
    };

    function paintMarks() {
      const marked = new Set([...(hovered ? [hovered] : []), ...focused]);
      grid.querySelectorAll<HTMLElement>('.day[data-ids]').forEach((cell) => {
        const ids = cell.dataset.ids!.split(' ');
        cell.classList.toggle('hl', ids.some((id) => marked.has(id)));
      });
      list.querySelectorAll<HTMLElement>('button[data-id]').forEach((b) => {
        b.classList.toggle('hl', marked.has(b.dataset.id!));
      });
    }

    function render() {
      title.textContent = `${MONTHS[viewMonth - 1]} ${viewYear}`;
      grid.innerHTML = '';
      const first = new Date(Date.UTC(viewYear, viewMonth - 1, 1));
      const offset = (first.getUTCDay() + 6) % 7; // Monday first
      const days = new Date(Date.UTC(viewYear, viewMonth, 0)).getUTCDate();
      const today = new Date();
      const todayKey = ymd(today.getFullYear(), today.getMonth() + 1, today.getDate());

      for (let i = 0; i < offset; i++) grid.append(document.createElement('span'));
      for (let d = 1; d <= days; d++) {
        const key = ymd(viewYear, viewMonth, d);
        const dayEvents = byDay.get(key);
        const cell = document.createElement(dayEvents ? 'button' : 'span');
        cell.className = 'day';
        cell.textContent = String(d);
        if (key === todayKey) cell.classList.add('today');
        if (dayEvents) {
          (cell as HTMLButtonElement).type = 'button';
          cell.dataset.ids = dayEvents.map((e) => e.id).join(' ');
          cell.classList.add('has-event');
          // Days covered only by long ranges (stays, month-long events) get a lighter style.
          if (dayEvents.every((e) => longEvents.has(e))) cell.classList.add('long');
          const prev = byDay.get(ymd(viewYear, viewMonth, d - 1));
          const next = byDay.get(ymd(viewYear, viewMonth, d + 1));
          const shares = (other?: CalEvent[]) => !!other?.some((e) => dayEvents.includes(e));
          if (shares(prev) || shares(next)) cell.classList.add('range');
          if (!shares(prev)) cell.classList.add('range-start');
          if (!shares(next)) cell.classList.add('range-end');
          const names = dayEvents.map((e) => e.title);
          cell.title = names.join('\n');
          cell.setAttribute('aria-label', `${d} ${MONTHS[viewMonth - 1]}: ${names.join(', ')}`);
          // Prefer short events over long ranges when a day has both; colour by that event.
          const ordered = [...dayEvents].sort((a, b) => Number(longEvents.has(a)) - Number(longEvents.has(b)));
          cell.dataset.cat = ordered[0].category;
          if (new Set(dayEvents.map((e) => e.category)).size > 1) cell.classList.add('multi');
          cell.addEventListener('click', () => emit('activities:select', { ids: ordered.map((e) => e.id) }));
        }
        grid.append(cell);
      }

      list.innerHTML = '';
      const monthEvents = byMonth.get(`${viewYear}-${pad(viewMonth)}`) ?? [];
      if (monthEvents.length === 0) {
        const li = document.createElement('li');
        li.className = 'empty';
        li.textContent = 'Nothing this month.';
        list.append(li);
      }
      for (const e of monthEvents) {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.id = e.id;
        btn.dataset.cat = e.category;
        const [sy, sm, sd] = e.start.split('-').map(Number);
        const startsHere = sy === viewYear && sm === viewMonth;
        btn.innerHTML = `<span class="dot"></span><span class="when">${sd && startsHere ? sd : '·'}</span><span class="what"></span>`;
        btn.querySelector('.what')!.textContent = e.title;
        btn.addEventListener('click', () => emit('activities:select', { ids: [e.id] }));
        li.append(btn);
        list.append(li);
      }

      years.querySelectorAll<HTMLElement>('.month').forEach((b) => {
        b.classList.toggle('current', b.dataset.month === `${viewYear}-${pad(viewMonth)}`);
      });
      paintMarks();
    }

    function show(year: number, month: number, { announce = true } = {}) {
      const yearChanged = year !== viewYear;
      viewYear = year;
      viewMonth = month;
      render();
      if (yearChanged && announce) emit('activities:year', { year });
    }

    function go(delta: number) {
      let y = viewYear;
      let m = viewMonth + delta;
      if (m < 1) { m = 12; y--; }
      if (m > 12) { m = 1; y++; }
      show(y, m);
    }

    // Year overview: one row per year, 12 month cells shaded by activity.
    const buildYears = () => {
    years.querySelectorAll('.year-row').forEach((r) => r.remove());
    const allYears = events.map((e) => Number(e.start.slice(0, 4)));
    const maxYear = Math.max(...allYears, viewYear);
    const minYear = Math.min(...allYears, viewYear);
    for (let y = maxYear; y >= minYear; y--) {
      const row = document.createElement('div');
      row.className = 'year-row';
      const label = document.createElement('span');
      label.className = 'year-label';
      label.textContent = String(y);
      row.append(label);
      const months = document.createElement('div');
      months.className = 'months';
      for (let m = 1; m <= 12; m++) {
        const mk = `${y}-${pad(m)}`;
        const count = byMonth.get(mk)?.length ?? 0;
        const b = document.createElement('button');
        b.type = 'button';
        b.className = `month level-${Math.min(count, 3)}`;
        b.dataset.month = mk;
        b.textContent = MONTHS[m - 1][0];
        b.title = `${MONTHS[m - 1]} ${y}${count ? ` · ${count} ${count === 1 ? 'entry' : 'entries'}` : ''}`;
        b.addEventListener('click', () => {
          show(y, m, { announce: false });
          emit('activities:goto-month', { year: y, month: m });
        });
        months.append(b);
      }
      row.append(months);
      years.append(row);
    }
    };
    buildYears();

    root.querySelector('[data-prev]')!.addEventListener('click', () => go(-1), { signal });
    root.querySelector('[data-next]')!.addEventListener('click', () => go(1), { signal });

    // Feed → calendar.
    document.addEventListener(
      'activities:highlight',
      (ev) => {
        const { id, start } = (ev as CustomEvent<{ id: string | null; start?: string }>).detail;
        hovered = id;
        if (id && start) {
          const [y, m] = start.split('-').map(Number);
          if (y !== viewYear || m !== viewMonth) show(y, m, { announce: false });
        }
        paintMarks();
      },
      { signal },
    );
    document.addEventListener(
      'activities:show-year',
      (ev) => {
        const { year } = (ev as CustomEvent<{ year: number }>).detail;
        if (year !== viewYear) show(year, latestMonthOf(year), { announce: false });
      },
      { signal },
    );
    document.addEventListener(
      'activities:focused',
      (ev) => {
        const { ids, start } = (ev as CustomEvent<{ ids: string[]; start?: string }>).detail;
        focused = ids;
        if (start) {
          const [y, m] = start.split('-').map(Number);
          if (y !== viewYear || m !== viewMonth) show(y, m, { announce: false });
        }
        paintMarks();
      },
      { signal },
    );

    document.addEventListener(
      'activities:filter',
      (ev) => {
        categories = new Set((ev as CustomEvent<{ categories: string[] }>).detail.categories);
        buildIndex();
        buildYears();
        render();
      },
      { signal },
    );

    // Follow the reader: show the month whose entries are on screen.
    const io = new IntersectionObserver(
      (entries) => {
        if (hovered) return;
        const visible = entries.filter((e) => e.isIntersecting);
        if (!visible.length) return;
        const mk = (visible[0].target as HTMLElement).dataset.month;
        if (!mk) return;
        const [y, m] = mk.split('-').map(Number);
        if (y !== viewYear || m !== viewMonth) show(y, m, { announce: false });
      },
      { rootMargin: '-20% 0px -65% 0px' },
    );
    document.querySelectorAll('[data-month]').forEach((el) => {
      if (el.closest('[data-activity-calendar]')) return;
      io.observe(el);
    });
    signal.addEventListener('abort', () => io.disconnect());

    render();
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => abort?.abort());
</script>

<style>
  .calendar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (max-width: 899px) {
    .calendar {
      width: 100%;
      max-width: 24rem;
      margin-inline: auto;
    }
  }
  @media (scripting: none) {
    .calendar { display: none; }
  }
  .card {
    padding: 1.1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background-color: var(--bg);
    box-shadow: var(--shadow-sm);
  }
  .cal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .cal-title {
    font-weight: 600;
    color: var(--accent);
  }
  .nav {
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--fg-soft);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .nav:hover {
    color: var(--accent);
    border-color: var(--accent-soft);
    background-color: var(--accent-tint);
  }
  .weekdays,
  .grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
  }
  .weekdays {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-mute);
    margin-bottom: 0.3rem;
  }
  .grid {
    row-gap: 0.2rem;
  }
  .grid :global(.day) {
    display: grid;
    place-items: center;
    height: 2rem;
    width: 100%;
    max-width: 2.6rem;
    justify-self: center;
    font: inherit;
    font-size: 0.85rem;
    color: var(--fg-soft);
    border: none;
    background: none;
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }
  .grid :global(.day.today) {
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
  .grid :global(.day.has-event) {
    color: #fff;
    font-weight: 600;
    background-color: var(--cat);
    cursor: pointer;
    transition: transform 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .grid :global(.day.has-event:hover) {
    filter: brightness(0.88);
    transform: scale(1.1);
  }
  .grid :global(.day.range) {
    border-radius: 0;
    background-color: color-mix(in srgb, var(--cat) 78%, var(--bg));
  }
  .grid :global(.day.range.range-start) { border-radius: 999px 0 0 999px; background-color: var(--cat); }
  .grid :global(.day.range.range-end) { border-radius: 0 999px 999px 0; background-color: var(--cat); }
  .grid :global(.day.range.range-start.range-end) { border-radius: 999px; }
  .grid :global(.day.range:hover) { transform: none; }
  /* Several kinds of activity on the same day: small marker. */
  .grid :global(.day.multi) { position: relative; }
  .grid :global(.day.multi::after) {
    content: '';
    position: absolute;
    top: 2px;
    right: 2px;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background-color: var(--bg);
    box-shadow: 0 0 0 1.5px var(--cat);
  }
  .grid :global(.day.long),
  .grid :global(.day.long.range),
  .grid :global(.day.long.range-start),
  .grid :global(.day.long.range-end) {
    color: var(--cat-fg);
    font-weight: 500;
    background-color: var(--cat-bg);
  }
  .grid :global(.day.long:hover) { filter: brightness(0.95); }
  .grid :global(.day.hl) {
    color: #fff;
    background-color: var(--cat);
    filter: brightness(0.85);
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--cat);
    transform: scale(1.08);
    position: relative;
    z-index: 1;
  }
  .grid :global(.day.range.hl) {
    box-shadow: none;
    transform: none;
  }
  .grid :global(.day.long.hl) {
    color: #fff;
    background-color: var(--cat);
    filter: none;
    box-shadow: none;
    transform: none;
  }

  .month-events {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.9rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .month-events :global(button) {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    width: 100%;
    padding: 0.35rem 0.4rem;
    border: none;
    border-radius: 6px;
    background: none;
    text-align: left;
    font: inherit;
    font-size: 0.85rem;
    color: var(--fg-soft);
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .month-events :global(button.hl),
  .month-events :global(button:hover) {
    background-color: var(--accent-tint);
    color: var(--accent);
  }
  .month-events :global(.dot) {
    flex-shrink: 0;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background-color: var(--cat);
    transform: translateY(-1px);
  }
  .month-events :global(button) { align-items: center; }
  .month-events :global(button.hl),
  .month-events :global(button:hover) {
    background-color: var(--cat-bg);
    color: var(--cat-fg);
  }
  .month-events :global(.when) {
    min-width: 1.4rem;
    font-weight: 600;
    color: var(--accent-soft);
    font-variant-numeric: tabular-nums;
  }
  .month-events :global(.empty) {
    font-size: 0.85rem;
    color: var(--fg-mute);
    font-style: italic;
    padding: 0.2rem 0.4rem;
  }

  .years-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .years :global(.year-row) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .years :global(.year-row + .year-row) { margin-top: 0.4rem; }
  .years :global(.year-label) {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--fg-mute);
    font-variant-numeric: tabular-nums;
  }
  .years :global(.months) {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 3px;
  }
  .years :global(.month) {
    aspect-ratio: 1;
    min-width: 0;
    max-width: 1.75rem;
    width: 100%;
    justify-self: center;
    padding: 0;
    border: none;
    border-radius: 4px;
    font: inherit;
    font-size: 0.6rem;
    color: var(--fg-mute);
    background-color: var(--bg-soft);
    cursor: pointer;
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .years :global(.month:hover) { transform: scale(1.15); }
  .years :global(.month.level-1) { background-color: color-mix(in srgb, var(--accent) 32%, var(--bg)); color: var(--accent); }
  .years :global(.month.level-2) { background-color: var(--accent-soft); color: var(--on-accent); }
  .years :global(.month.level-3) { background-color: var(--accent); color: var(--on-accent); }
  .years :global(.month.current) { box-shadow: 0 0 0 2px var(--bg), 0 0 0 3.5px var(--accent); }
</style>
